# Redis configuration

# SECURITY WARNING: Always set a strong Redis password in production!

# Without a password, any client that can reach your Redis port

# will have unrestricted access to all cached data.

CONCURRENT_TEST=

REDIS_CLUSTER=false

REDIS_CLUSTER_NODES=

REDIS_HOST=localhost

REDIS_PORT=6379

REDIS_PASSWORD=your-strong-redis-password

REDIS_USER=

REDIS_TLS=false
